{
  "cli": {
    "version": ">=16.26.0",
    "appVersionSource": "local"
  },
  "build": {
    "android-development": {
      "node": "20.19.4",
      "android": {
        "buildType": "apk"
      },
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "android-production": {
      "node": "20.19.4",
      "android": {
        "buildType": "app-bundle"
      },
      "developmentClient": false,
      "distribution": "store",
      "env": {
        "APP_VARIANT": "production"
      }
    },
    "ios-development": {
      "node": "20.19.4",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "ios-testflight": {
      "node": "20.19.4",
      "distribution": "store",
      "env": {
        "APP_VARIANT": "production"
      }
    }
  }
}
